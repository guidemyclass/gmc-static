---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Steps2 from '~/components/widgets/Steps2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="Let's Connect!" />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Contact Us"
    items={[
      {
        title: 'WhatsApp',
        description: "🚀 Fastest reply!",
        href: 'https://wa.link/guidemyclass',
        icon: 'tabler:brand-whatsapp',
        color: 'bg-green-500'
      },
      {
        title: 'Telegram',
        description: "🔒 100% Privacy",
        href: 'http://t.me/guidemyclass',
        icon: 'tabler:brand-telegram',
        color: 'bg-blue-400'
      },
      {
        title: 'Snapchat',
        description: "👻 Add us on Snapchat",
        href: 'https://www.snapchat.com/add/tutorsinn',
        icon: 'tabler:brand-snapchat',
        color: 'bg-yellow-500'
      },
      {
        title: 'Instagram',
        description: "Follow & message us",
        href: 'https://www.instagram.com/essaysinn/',
        icon: 'tabler:brand-instagram',
        color: 'bg-pink-500'
      },
      {
        title: 'Email',
        description: "📧 support@guidemyclass.com",
        href: 'mailto:support@guidemyclass.com',
        icon: 'tabler:mail',
        color: 'bg-primary'
      },
      {
        title: 'WeChat',
        description: "Click here to scan and contact",
        href: 'wechat',
        icon: 'tabler:brand-wechat',
        color: 'bg-green-600'
      }
    ]}
  />
  
  <!-- Steps2 Widget ****************** -->

  <Steps2
    subtitle="For quicker answers, explore our FAQs section. You may find the solution you're looking for right there! If not, our support team is delighted to help you."
    callToAction={{
      text: 'FAQs',
      href: '/faqs',
    }}
    items={[
    ]}
  />
</Layout>
